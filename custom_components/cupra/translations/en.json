  "issues": {
    "no_subscription": {
      "title": "{vehicle}: no EU Data Act data request",
      "description": "The portal has no continuous data request for car …{vin}. Open https://eu-data-act.drivesomethinggreater.com, choose CUPRA, select the car and create a continuous request (15-minute interval). The integration picks it up automatically."
    },
    "ola_blocked": {
      "title": "{vehicle}: My Cupra API blocked",
      "description": "VW refused the My Cupra app API (HTTP 403, App Check). GPS position and remote commands are switched off; data from the EU Data Act keeps working. The integration retries every 6 hours."
    }
