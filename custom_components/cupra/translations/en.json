{
  "config": {
    "step": {
      "user": {
        "title": "Connect your Cupra",
        "description": "Log in with your **CUPRA ID** (the same e-mail and password as in the My Cupra app).\n\nData comes from the official **VW Group EU Data Act** portal. Before the first data arrives, open https://eu-data-act.drivesomethinggreater.com, choose CUPRA, log in, pick your car and create a **continuous** data request (every 15 minutes). The first files can take from minutes up to 1–3 days.",
        "data": {
          "email": "E-mail (CUPRA ID)",
          "password": "Password",
          "use_ola": "Also use the My Cupra app connection (GPS and remote commands)",
          "country": "Portal country code",
          "language": "Portal language code"
        },
        "data_description": {
          "use_ola": "Since June 2026 VW blocks most third-party access to this API. The integration tries it and switches commands off automatically if it is refused.",
          "country": "Two letters, e.g. de. Change only if login fails with HTTP 503."
        }
      },
      "vehicle": {
        "title": "Choose the vehicle",
        "data": {
          "vin": "Vehicle"
        }
      },
      "model": {
        "title": "Model and powertrain",
        "description": "The card layout and the car outline follow these settings for {vehicle}. Leave on automatic detection unless the card looks wrong.",
        "data": {
          "model": "Model",
          "powertrain": "Powertrain"
        }
      },
      "reauth_confirm": {
        "title": "Re-enter password",
        "description": "CUPRA ID rejected the saved password for {email}.",
        "data": {
          "password": "Password"
        }
      }
    },
    "error": {
      "invalid_auth": "Wrong e-mail or password (or new terms need to be accepted in the My Cupra app).",
      "cannot_connect": "The VW portal is not reachable right now. Try again later.",
      "no_vehicles": "No vehicles are linked to this CUPRA ID."
    },
    "abort": {
      "already_configured": "This vehicle is already configured.",
      "reauth_successful": "Password updated."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Cupra options",
        "data": {
          "model": "Model",
          "powertrain": "Powertrain",
